# Uniswap Developer Platform key. Self serve and free at https://developers.uniswap.org/dashboard
# Rate limit is 6 requests per second. Used as the x-api-key header on every LP call.
UNISWAP_API_KEY=

# Deployer. Needs Sepolia ETH. Never commit this file.
DEPLOYER_PRIVATE_KEY=

# Optional. Defaults to a public endpoint, which is rate limited enough to hurt during a demo.
SEPOLIA_RPC_URL=

# Optional but recommended: contract verification is a table stake, a judge who clicks an
# unverified address stops reading. https://etherscan.io/myapikey
ETHERSCAN_API_KEY=

# Optional. An endpoint the browser may call directly, instead of the proxied one above.
#
# Anything named VITE_ is inlined into the JavaScript the browser downloads. It is not a secret, it is
# published, and no proxy stands in front of it: whoever opens the page can read it out of the bundle and
# spend the quota. So put a public endpoint here, never a keyed one. A keyed provider URL belongs in
# SEPOLIA_RPC_URL above, which only the solver and the server side proxy ever read.
VITE_SEPOLIA_RPC_URL=

# Optional. A WalletConnect project id, self serve and free at https://cloud.reown.com.
# Set it and the frontend offers WalletConnect alongside the injected and Coinbase Wallet connectors, which is
# what lets a phone wallet scan a code and take a fill. Leave it empty and WalletConnect is simply not offered:
# nothing breaks and no dead button appears. Safe to commit to a bundle, it identifies the dapp, not a user.
VITE_WALLETCONNECT_PROJECT_ID=
