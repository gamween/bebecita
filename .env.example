# Uniswap Developer Platform key. Self serve and free at https://developers.uniswap.org/dashboard
# Rate limit is 6 requests per second. Used as the x-api-key header on every LP call.
UNISWAP_API_KEY=

# Deployer. Needs Sepolia ETH. Never commit this file.
DEPLOYER_PRIVATE_KEY=

# Optional. Defaults to a public endpoint, which is rate limited enough to hurt during a demo.
SEPOLIA_RPC_URL=

# Optional but recommended: contract verification is a table stake, a judge who clicks an
# unverified address stops reading. https://etherscan.io/myapikey
ETHERSCAN_API_KEY=

# Optional. Where `yarn solver:serve` listens, and where the dev server proxies /api/solver.
# Defaults to 127.0.0.1:8787 on both sides, so the fill button works with nothing set here.
SOLVER_PORT=
SOLVER_URL=

# Optional. Set this to make the frontend post fills straight to a solver instead of through the
# dev server proxy, for instance when it runs on another machine. Reaches the bundle, so no secrets.
VITE_SOLVER_URL=

# Optional. An endpoint the browser may call directly, instead of the proxied one above.
VITE_SEPOLIA_RPC_URL=
